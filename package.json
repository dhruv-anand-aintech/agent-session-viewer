{
  "name": "agent-session-viewer",
  "version": "0.1.37",
  "description": "Live multi-platform AI coding session viewer — Claude Code, Cursor, Codex, OpenCode, Hermes, Antigravity",
  "type": "module",
  "bin": {
    "agent-session-viewer": "bin/agent-session-viewer.mjs",
    "agent-session-viewer-rate-limit-install": "scripts/install-rate-limit-watch.sh",
    "agent-session-viewer-rate-limit-uninstall": "scripts/uninstall-rate-limit-watch.sh",
    "agent-session-viewer-rate-limit-watch": "scripts/rate-limit-transcript-watcher.py"
  },
  "files": [
    "bin/",
    "dist/",
    "lib/",
    "local-server.mjs",
    "build-cache.mjs",
    "setup-local.mjs",
    "shared-utils.mjs",
    "platform-readers.mjs",
    "scripts/com.dhruvanand.agent-session-viewer.rate-limit-watch.plist",
    "scripts/gemini-transcript-archive-hook.py",
    "scripts/install-gemini-transcript-archive-hook.py",
    "scripts/install-rate-limit-watch.sh",
    "scripts/rate-limit-alarm.py",
    "scripts/rate-limit-transcript-watcher.py",
    "scripts/uninstall-rate-limit-watch.sh"
  ],
  "keywords": [
    "ai",
    "claude",
    "cursor",
    "codex",
    "opencode",
    "session-viewer",
    "devtools"
  ],
  "author": "Dhruv Anand",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhruv-anand-aintech/agent-session-viewer.git"
  },
  "scripts": {
    "prepare": "npm run build",
    "dev": "vite",
    "dev:api": "node dev-server.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "local": "node scripts/run-local-dev.mjs",
    "build-search-index": "node scripts/build-search-index.mjs",
    "build-cache": "node build-cache.mjs",
    "setup": "node setup-local.mjs",
    "setup:cloudflare": "node setup.mjs",
    "deploy": "node deploy.mjs",
    "publish:studies": "node scripts/publish-studies.mjs",
    "configure:directory": "node scripts/configure-worker-directory.mjs",
    "deploy:directory": "npx wrangler deploy --config wrangler.directory.toml",
    "rate-limit-watch": "python3 scripts/rate-limit-transcript-watcher.py",
    "rate-limit-watch:launchd-install": "bash scripts/install-rate-limit-watch.sh",
    "rate-limit-watch:launchd-uninstall": "bash scripts/uninstall-rate-limit-watch.sh",
    "rate-limit-watch:launchd-restart": "bash -c 'launchctl kickstart -k gui/$(id -u)/com.dhruvanand.agent-session-viewer.rate-limit-watch'",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/*.test.mjs && vitest run",
    "test:tunnel-regression": "node scripts/tunnel-load-regression.mjs",
    "test:tunnel": "node scripts/tunnel-browser-test.mjs",
    "tunnel:install": "bash scripts/install-tunnel-daemon.sh",
    "tunnel:warm-install": "bash scripts/install-tunnel-warm.sh",
    "tunnel:warm": "bash scripts/tunnel-warm.sh",
    "cloud:broadcast": "node scripts/asv-broadcaster.mjs",
    "agent:runner": "node scripts/asv-agent-runner.mjs",
    "gcp:create-agent-vm": "bash scripts/gcp-free-agent-vm.sh",
    "test:prepush": "npm test && npm run test:tunnel-regression"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@inquirer/prompts": "^8.4.3",
    "@lancedb/lancedb": "^0.27.2",
    "@ngrok/ngrok": "^1.7.0",
    "@tanstack/react-virtual": "^3.14.5",
    "better-sqlite3": "^12.9.0",
    "fuse.js": "^7.3.0",
    "lucide-react": "^1.17.0",
    "marked": "^17.0.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "smol-toml": "^1.6.1",
    "untun": "^0.1.3",
    "wouter": "^3.9.0"
  },
  "devDependencies": {
    "@cloudflare/kv-asset-handler": "^0.4.2",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "playwright": "^1.52.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.98.0"
  }
}
