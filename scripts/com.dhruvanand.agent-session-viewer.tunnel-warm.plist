<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.dhruvanand.agent-session-viewer.tunnel-warm</string>
	<key>ProgramArguments</key>
	<array>
		<string>ROOT_PLACEHOLDER/scripts/tunnel-warm.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>TUNNEL_URL</key>
		<string>https://agent-session-viewer.ainorthstar.tech</string>
	</dict>
	<key>StartInterval</key>
	<integer>180</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>LOG_PLACEHOLDER/agent-session-viewer-tunnel-warm.log</string>
	<key>StandardErrorPath</key>
	<string>LOG_PLACEHOLDER/agent-session-viewer-tunnel-warm.err.log</string>
</dict>
</plist>
