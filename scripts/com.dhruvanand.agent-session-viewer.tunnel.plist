<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.dhruvanand.agent-session-viewer.tunnel</string>
	<key>ProgramArguments</key>
	<array>
		<string>CLOUDFLARED_PLACEHOLDER</string>
		<string>tunnel</string>
		<string>--no-autoupdate</string>
		<string>--protocol</string>
		<string>http2</string>
		<string>--config</string>
		<string>CONFIG_PLACEHOLDER</string>
		<string>run</string>
		<string>agent-session-viewer</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>LOG_PLACEHOLDER/agent-session-viewer-tunnel.log</string>
	<key>StandardErrorPath</key>
	<string>LOG_PLACEHOLDER/agent-session-viewer-tunnel.err.log</string>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
