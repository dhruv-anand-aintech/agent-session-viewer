<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.dhruvanand.agent-session-viewer.rate-limit-watch</string>
	<key>ProgramArguments</key>
	<array>
		<string>PYTHON_BIN_PLACEHOLDER</string>
		<string>RUNNER_DIR_PLACEHOLDER/rate-limit-transcript-watcher.py</string>
	</array>
	<key>WorkingDirectory</key>
	<string>RUNNER_DIR_PLACEHOLDER</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>LOG_PLACEHOLDER/agent-session-viewer-rate-limit-watch.log</string>
	<key>StandardErrorPath</key>
	<string>LOG_PLACEHOLDER/agent-session-viewer-rate-limit-watch.err.log</string>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
